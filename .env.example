# Example .env file — copy to `.env` and fill in your own keys.
# The real `.env` is git-ignored; this template is safe to commit.

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
